{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cosmotrak-data-delivery",
  "main": "src/index.mjs",
  "account_id": "52018eaf0359596038f45ce3b2443891",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "data.cosmotrak.com", "custom_domain": true}],
  "r2_buckets": [{"binding": "DATABASES", "bucket_name": "cosmotrak-data-prod"}],
  "observability": {"enabled": true, "head_sampling_rate": 1}
}
