APP_ENV=docker
APP_DEBUG=0
DATABASE_URL=sqlite:///%kernel.project_dir%/var/db/app.db
DATABASE_SQLITE_ENFORCE_FOREIGN_KEYS=1
DEFAULT_URI=https://partdb.jacob-neel.dev/
DEFAULT_LANG=en
DEFAULT_TIMEZONE=America/Chicago
BASE_CURRENCY=USD
INSTANCE_NAME=Olympus Part-DB
ALLOW_ATTACHMENT_DOWNLOADS=0
USE_GRAVATAR=0
MCP_ENABLED=1
MCP_EDITING_ENABLED=1
TRUSTED_PROXIES=127.0.0.1,10.244.0.0/16
TRUSTED_HOSTS=^(partdb\.jacob-neel\.dev|olympus-partdb(\.taild90e78\.ts\.net)?|localhost)$
SAML_ENABLED=1
SAML_BEHIND_PROXY=1
SAML_SP_ENTITY_ID=https://partdb.jacob-neel.dev/saml/metadata
SAML_IDP_ENTITY_ID=https://auth.jacob-neel.dev/application/saml/partdb/metadata/
SAML_IDP_SINGLE_SIGN_ON_SERVICE=https://auth.jacob-neel.dev/application/saml/partdb/sso/binding/redirect/
SAML_IDP_SINGLE_LOGOUT_SERVICE=https://auth.jacob-neel.dev/application/saml/partdb/slo/binding/redirect/
SAML_ROLE_MAPPING={"partdb-admin":1}
SAML_UPDATE_GROUP_ON_LOGIN=1
APACHE_RUN_DIR=/tmp/apache-run
APACHE_LOCK_DIR=/tmp/apache-lock
APACHE_PID_FILE=/tmp/apache-run/apache2.pid
